<div class="container-fluid px-4 py-3">

    <h1> Response Charts</h1>

    <div>

        <%= form_with url: response_chart_path, method: :get, data: {turbo_frame: "Charts"} do |picker| %>

            <div>
                <%= select_tag :form_id,
                        options_from_collection_for_select(@forms, :id, :name, @form&.id),
                        include_blank: "Select a form",
                        class: "form-select form-select-sm bg-dark text-white text-wrap",
                        style: "width:16.4%",
                        onchange: "this.form.requestSubmit()" %>
            </div>

        <%end%>

    </div>


    <div>
        <%= turbo_frame_tag "Charts" do %>

            <% if @form == nil %>

                

            <% else %>

                <div class = "container-fluid py-3">

                    <%= form_with url: response_chart_path, method: :get, data: {turbo_frame: "Charts"} do |filter| %>

                        <%= filter.hidden_field :form_id, value: @form.id %>
                        <%= hidden_field_tag "question_ids[]", "", id: nil %>

                        <div class = "row">
                            <% @questions.each do |q| %>
                                <div class = "col-auto form-check">
                                    <%= check_box_tag "question_ids[]", q.id, @selected_ids.include?(q.id),
                                            id: "question_#{q.id}", class: "form-check-input",
                                            onchange: "this.form.requestSubmit()" %>
                                    <%= label_tag "question_#{q.id}", q.words, class: "form-check-label" %>
                                </div>
                            <%end%>
                        </div>

                    <%end%>

                </div>

                <% if @questions.empty? %>

                    <div class = "container py-3 text-muted">This form has no chartable questions.</div>

                <% elsif @charts.empty? %>

                    <div class = "container py-3 text-muted">No charts selected.</div>

                <%end%>

                <% @charts.each do |chart| %>

                    <div class = "row py-1">

                        <% if chart[:data].empty? %>
                            <div class = "text-muted"><%= chart[:title] %> &mdash; no responses yet</div>
                        <% else %>
                            <%= question_chart_tag(chart) %>
                        <%end%>

                    </div>

                <%end%>

                <%= chart_script_tag scope: "Charts" %>

            <%end%>

        <%end%>
    </div>

</div>
