<div class ="container-fluid px-4 py-3">

    

    <h1>View Responses</h1>
    

    <div>

        <%= form_with url: response_view_path, method: :get, data: {turbo_frame: "Questionaire"} do |something| %>
            <div>
                <select class = "form-select form-select-sm bg-dark text-white text-wrap" id="Form-ID" name = "<%= "choose2" %>" style = "width:16.4%" onchange = "this.form.requestSubmit()" required>
                    
                    <option selected>Select a form</option>
                    <% @form.each do |f| %>
                        <option><%= f.name %></option>
                    <%end%>

                </select>


            </div>
            
        <%end%>

    </div>
    
    
    <div>
        <%= turbo_frame_tag "Questionaire" do %>

            <% current_page = params[:page].to_i %>
            <% current_page = 1 if current_page < 1 %>
            

            <div class = "container py-3">
                <% @pickedform = Form.find_by(name: @forchoice) %>

                

                <% if @pickedform != nil %>

                    <% total_pages = ((Float(Response.where(form_name: @pickedform.name).count)) / 20).ceil %>
                    
                    <% current_page = total_pages if current_page >= total_pages %>

                    <%@response = Response.where(form_name: @pickedform.name).offset((current_page - 1) * 20).limit(20)%>

                    <div class = "row g-0 text-center text-sm" style = "font-size: 12px">
                    
                        <% @pickedform.questions.each do |q| %>

                                <div class = "col">

                                    <div class="border border-warning" style = "height: 110%"> <%= q.words %> </div>
                                    
                                    

                                </div>

                        <%end%>

                    </div>

                    <% @response.each do |r| %>
                        <div class = "row g-0 text-center text-sm" style = "font-size: 12px">

                            <% r.inputs.each do |i| %>
                                <div class = "col">
                                    <div class="border border-warning bg-light" style = "height: 110%" >  <%= i.answer %> </div>
                                    

                                </div>


                            <%end%>
                            
                        </div>
                    <%end%>

                    <div class = "py-2">

                        <%= link_to "First", request.params.merge(page: 1), class: "btn btn-dark", data: { turbo_frame: "Questionaire" } if current_page > 1 %>

                        <%= link_to "Previous", request.params.merge(page: current_page - 1), class: "btn btn-dark", data: { turbo_frame: "Questionaire" } if current_page > 1 %>

                        <%= link_to "Next", request.params.merge(page: current_page + 1), class: "btn btn-dark", data: { turbo_frame: "Questionaire" } if @response.count == 20 %>

                        <%= link_to "Last", request.params.merge(page: total_pages), class: "btn btn-dark", data: { turbo_frame: "Questionaire" } if @response.count == 20 %>


                    </div>

                    <% if total_pages > 1 %>
                    
                        <div class = "container text-center">

                            Page <%= current_page %> of <%= total_pages %>

                        </div>

                        <div class = "container text-center">

                            <%= form_with url: response_view_path, method: :get, data: {turbo_frame: "Questionaire"} do |form| %>

                                <div>
                                    <%= form.hidden_field :choose2, value: "Better Test Form", required: true %>
                                    <%= form.number_field :page, class: "form-control-sm", placeholder: "Enter page number" %>

                                    <%= form.submit "Go", class: "btn-sm btn-dark" %>


                                </div>
                                
                            <%end%>

                        </div>
                    <%end%>

                <%end%>
            </div>

            

        <%end%>

    </div>











</div>